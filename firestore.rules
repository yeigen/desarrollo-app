rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /progress/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'points', 'missions', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 120
        && request.resource.data.missions is list
        && request.resource.data.missions.size() == 3
        && request.resource.data.updatedAt == request.time;
    }
  }
}
